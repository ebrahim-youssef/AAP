{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/pharmacy/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Almarai))/i]",
        "message": "Font not provided by the design system. Available: Almarai."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:branch|onBranch|title|lede|children|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: branch, onBranch, title, lede, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:branch|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<BranchButton> doesn't accept that prop. Declared props: branch, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onBrand|light)$/]",
        "message": "<BranchButton> tone must be one of 'onBrand' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|address|hours|phone|verified|onCall|onDirections|onWhatsApp|key|ref|className|style|children)$/]",
        "message": "<BranchCard> doesn't accept that prop. Declared props: name, address, hours, phone, verified, onCall, onDirections, onWhatsApp."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconEnd|block|disabled|loading|href|type|onClick|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconEnd, block, disabled, loading, href, type, onClick, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hairline|band)$/]",
        "message": "<Divider> variant must be one of 'hairline' | 'band'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<FactList> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ListLink> doesn't accept that prop. Declared props: icon, title, description, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|boxed|children|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, boxed, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:note|warning|danger)$/]",
        "message": "<Notice> tone must be one of 'note' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|currency|label|updatedAt|branch|status|statusLabel|size|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: price, currency, label, updatedAt, branch, status, statusLabel, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:check|confirmed|unavailable)$/]",
        "message": "<PriceTag> status must be one of 'check' | 'confirmed' | 'unavailable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<PriceTag> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|latin|price|currency|updatedAt|status|statusLabel|onClick|key|ref|className|style|children)$/]",
        "message": "<ProductRow> doesn't accept that prop. Declared props: name, latin, price, currency, updatedAt, status, statusLabel, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:check|confirmed|unavailable|info)$/]",
        "message": "<ProductRow> status must be one of 'check' | 'confirmed' | 'unavailable' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|title|description|onSelect|key|ref|className|style|children)$/]",
        "message": "<RadioRow> doesn't accept that prop. Declared props: checked, title, description, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|onChange|onSubmit|onClear|variant|submitLabel|autoFocus|label|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, defaultValue, placeholder, onChange, onSubmit, onClear, variant, submitLabel, autoFocus, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:onBrand|sunken)$/]",
        "message": "<SearchField> variant must be one of 'onBrand' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|onAction|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|onClose|children|footer|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, description, onClose, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShelfEdge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|height|key|ref|className|style|children)$/]",
        "message": "<ShelfEdge> doesn't accept that prop. Declared props: tone, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShelfEdge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<ShelfEdge> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|key|ref|className|style|children)$/]",
        "message": "<StatusTag> doesn't accept that prop. Declared props: status, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusTag'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:check|confirmed|unavailable|info)$/]",
        "message": "<StatusTag> status must be one of 'check' | 'confirmed' | 'unavailable' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|items|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onChange, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|right|children|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, onBack, right, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|english|href|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: tone, size, english, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'brand' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
