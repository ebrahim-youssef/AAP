---
import "../styles/global.css";
import AppHeader from "../components/AppHeader.astro";
import Footer from "../components/Footer.astro";
import TabBar from "../components/TabBar.astro";

interface Props {
  description?: string;
  home?: boolean;
  title: string;
}

const {
  description = "صيدليات علي أمين في مصر",
  home = false,
  title,
} = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="aa-root">
    <a class="aa-skip-link" href="#main-content">تخطى للمحتوى</a>
    <AppHeader currentPath={currentPath} home={home} />
    <main id="main-content"><slot /></main>
    <Footer />
    <TabBar currentPath={currentPath} />
  </body>
</html>
