---
import type { Branch } from "../data/site";
import { localePath, type Locale } from "../lib/i18n";
import { getStrings } from "../i18n/strings";

interface Props {
  branch: Branch;
  locale: Locale;
}

const { branch, locale } = Astro.props;
const text = getStrings(locale);
const phone = branch.phone ?? text.missingData;
const name = locale === "en" ? branch.nameEn : branch.nameAr;
---
<article class="aa-branch">
  <div class="aa-branch__h">
    <h3>{name}</h3>
    <span class="aa-tag aa-tag--info">{text.missingData}</span>
  </div>
  <dl class="aa-branch__facts">
    <div>
      <dt>{text.branch.address}</dt>
      <dd>{branch.addressAr ?? text.missingData}</dd>
    </div>
    <div>
      <dt>{text.branch.hours}</dt>
      <dd>{branch.hoursAr ?? text.missingData}</dd>
    </div>
    <div>
      <dt>{text.branch.phone}</dt>
      <dd dir={branch.phone ? "ltr" : undefined}>{phone}</dd>
    </div>
  </dl>
  <a class="aa-btn aa-btn--secondary aa-btn--sm" href={localePath(locale, "branches/" + branch.slug)}>{text.branch.viewDetails}</a>
</article>
