---
import { localePath, type Locale } from "../lib/i18n";
import { getStrings } from "../i18n/strings";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = getStrings(locale);
---
<footer class="aa-site-footer">
  <span>© 2026 {text.brandName}</span>
  <nav aria-label={text.nav.legal}>
    <a href={localePath(locale, "about")}>{text.about.title}</a>
    <a href={localePath(locale, "terms")}>{text.terms.title}</a>
    <a href={localePath(locale, "privacy")}>{text.privacy.title}</a>
  </nav>
</footer>
