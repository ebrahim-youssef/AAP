---
interface Props {
  name: "house" | "search" | "message-circle" | "map-pin";
  size?: number;
}

const { name, size = 18 } = Astro.props;
---
<svg
  class="aa-inline-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "house" && <><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /><polyline points="9 22 9 12 15 12 15 22" /></>}
  {name === "search" && <><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></>}
  {name === "message-circle" && <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />}
  {name === "map-pin" && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" /></>}
</svg>
