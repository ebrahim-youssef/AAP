---
import Base from "../../layouts/Base.astro";
import { getStrings } from "../../i18n/strings";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = getStrings(locale);
---
<Base title={text.privacy.title} description={text.privacy.description}>
  <div class="aa-page">
    <h1>{text.privacy.title}</h1>
    <section class="aa-page__section aa-copy" aria-labelledby="privacy-title">
      <h2 id="privacy-title">{text.privacy.heading}</h2>
      <p>{text.privacy.first}</p>
      <p>{text.privacy.second}</p>
    </section>
  </div>
</Base>
