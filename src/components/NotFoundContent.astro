---
import ContactActions from "./ContactActions.astro";
import SearchField from "./SearchField.astro";
import { getStrings } from "../i18n/strings";
import { localePath, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  medicine?: boolean;
  showEnglishHome?: boolean;
}

const { locale, medicine = false, showEnglishHome = false } = Astro.props;
const text = getStrings(locale);
const heading = medicine ? text.medicine.missingTitle : text.notFound.heading;
const body = medicine ? text.medicine.missingBody : text.notFound.body;
---
<div class="aa-page aa-medicine-missing">
  <h1>{heading}</h1>
  <p>{body}</p>
  {showEnglishHome && (
    <p class="aa-medicine-back">
      <a href={localePath("en", "/")} lang="en">{text.notFound.englishHome}</a>
    </p>
  )}
  <section class="aa-page__section" aria-labelledby="missing-medicine-search-title">
    <h2 id="missing-medicine-search-title">{text.search.title}</h2>
    <SearchField id="missing-medicine-search" locale={locale} />
  </section>
  <section class="aa-page__section" aria-labelledby="missing-medicine-contact-title">
    <h2 id="missing-medicine-contact-title">{text.contact.askWhatsApp}</h2>
    <ContactActions locale={locale} />
  </section>
</div>
