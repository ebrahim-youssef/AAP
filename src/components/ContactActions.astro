---
import { branches, whatsapp } from "../data/site";
import { telHref, whatsappHref } from "../lib/contact";
import { localePath, type Locale } from "../lib/i18n";
import { getStrings, interpolate } from "../i18n/strings";

interface Props {
  medicineName?: string;
  locale: Locale;
}

const { medicineName, locale } = Astro.props;
const text = getStrings(locale);
const message = medicineName
  ? interpolate(text.contact.medicineMessage, { name: medicineName })
  : text.contact.pharmacistMessage;
const whatsappUrl = whatsappHref(whatsapp, message);
const dialogId = "branch-call-dialog";
---
<div class="aa-contact-actions">
  <div class="aa-contact-action">
    {whatsappUrl ? (
      <a class="aa-btn aa-btn--primary" href={whatsappUrl}>{text.contact.askWhatsApp}</a>
    ) : (
      <button class="aa-btn aa-btn--primary" type="button" disabled aria-describedby="whatsapp-missing">{text.contact.askWhatsApp}</button>
    )}
    {!whatsappUrl && <span id="whatsapp-missing" class="aa-contact-missing">{text.missingData}</span>}
  </div>
  <a
    class="aa-btn aa-btn--secondary"
    href={localePath(locale, "branches")}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-contact-call-trigger
  >{text.contact.callBranch}</a>
</div>

<dialog class="aa-contact-dialog" id={dialogId} aria-labelledby="branch-call-title">
  <div class="aa-contact-dialog__inner">
    <div class="aa-contact-dialog__header">
      <h2 id="branch-call-title">{text.contact.chooseBranch}</h2>
      <button class="aa-contact-dialog__close" type="button" data-dialog-close>{text.contact.close}</button>
    </div>
    <p>{text.contact.chooseBranchDescription}</p>
    <ul class="aa-contact-dialog__list">
      {branches.map((branch) => {
        const href = telHref(branch.phone);
        return (
          <li>
            <span>{locale === "en" ? branch.nameEn : branch.nameAr}</span>
            {href ? <a href={href} dir="ltr">{branch.phone}</a> : <span>{text.missingData}</span>}
          </li>
        );
      })}
    </ul>
  </div>
</dialog>

<script is:inline>
  document.querySelectorAll("[data-contact-call-trigger]").forEach((trigger) => {
    const dialogId = trigger.getAttribute("aria-controls");
    const dialog = dialogId ? document.getElementById(dialogId) : null;
    if (!(dialog instanceof HTMLDialogElement)) return;

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (!dialog.open) dialog.showModal();
      dialog.querySelector("[data-dialog-close]")?.focus();
    });
    dialog.querySelector("[data-dialog-close]")?.addEventListener("click", () => dialog.close());
  });
</script>
