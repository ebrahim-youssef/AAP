---
import StatusTag from "./StatusTag.astro";
import { getStrings } from "../i18n/strings";
import { formatPrice } from "../lib/format-price";

interface Props {
  currency?: string;
  label?: string;
  locale: "ar" | "en";
  price: number;
  size?: "lg" | "md";
  status?: "check" | "confirmed" | "unavailable";
  statusLabel?: string;
  updatedAt: string;
}

const {
  currency,
  label,
  locale,
  price,
  size = "lg",
  status = "check",
  statusLabel,
  updatedAt,
} = Astro.props;
const text = getStrings(locale);
const displayPrice = formatPrice(price);
---
<div class:list={["aa-price", size === "md" && "aa-price--md"]}>
  <div class="aa-price__top">
    <div>
      <small>{label ?? text.medicine.lastKnownPrice}</small>
      <b>{displayPrice}</b>
    </div>
    <span>{" "}{currency ?? text.medicine.currency}</span>
  </div>
  <div class="aa-rail">
    <span>{updatedAt}</span>
    <StatusTag status={status} label={statusLabel} rail={true} locale={locale} />
  </div>
</div>
