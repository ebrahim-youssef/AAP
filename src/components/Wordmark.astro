---
interface Props {
  english?: boolean;
  href?: string;
  locale?: "ar" | "en";
  size?: "md" | "sm" | "lg";
  tone?: "brand" | "inverse";
}

import { getStrings } from "../i18n/strings";

const {
  english = false,
  href,
  locale = "ar",
  size = "md",
  tone = "brand",
} = Astro.props;
const classes = [
  "aa-wm",
  tone === "inverse" ? "aa-wm--inverse" : "",
  size !== "md" ? `aa-wm--${size}` : "",
].filter(Boolean).join(" ");
const text = getStrings(locale);
const label = text.brandName;
---
{href ? (
  <a class={classes} href={href} aria-label={label}>
    <strong>{text.wordmark.primary}</strong>
    <small>{text.wordmark.secondary}</small>
    {english && <em>{text.wordmark.secondaryLine}</em>}
  </a>
) : (
  <span class={classes} aria-label={label}>
    <strong>{text.wordmark.primary}</strong>
    <small>{text.wordmark.secondary}</small>
    {english && <em>{text.wordmark.secondaryLine}</em>}
  </span>
)}
