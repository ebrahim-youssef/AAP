---
import MedicinePage from "../../components/pages/MedicinePage.astro";
import { isLocale, type Locale } from "../../lib/i18n";
import { loadMedicinePageData } from "../../lib/medicine-page";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const { asOf, row } = await loadMedicinePageData(slug);

Astro.response.headers.set(
  "Cache-Control",
  row ? "public, max-age=3600, s-maxage=86400" : "public, max-age=60, s-maxage=300",
);
if (!row) Astro.response.status = 404;

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "ar";
---
<MedicinePage asOf={asOf} locale={locale} row={row} slug={slug} />
