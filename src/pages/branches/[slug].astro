---
import BranchDetailPage from "../../components/pages/BranchDetailPage.astro";
import { branches } from "../../data/site";
import { isLocale, type Locale } from "../../lib/i18n";

export const prerender = true;

export function getStaticPaths() {
  return branches.map((branch) => ({
    params: { slug: branch.slug },
    props: { branch },
  }));
}

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "ar";
---
<BranchDetailPage branch={Astro.props.branch} locale={locale} />
